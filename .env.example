# ---- Core -------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public URL. Used in emails, sitemap, Stripe redirects. No trailing slash.
BASE_URL=https://tenderping.eu
# Signs unsubscribe/settings links AND guards /ops/* job triggers.
# Generate with: openssl rand -hex 32
APP_SECRET=

# ---- Brand / legal (German Impressum requirements) ---------------------
BRAND_NAME=TenderPing
BRAND_TAGLINE=Every new EU public IT tender, filtered to the ones you could actually win.
FROM_EMAIL=alerts@tenderping.eu
REPLY_TO=hello@tenderping.eu
LEGAL_NAME=Your Name (Einzelunternehmer)
LEGAL_ADDRESS=Street 1, 89073 Ulm, Germany

# ---- Data source (TED) -------------------------------------------------
# TED Search API is anonymous — no key, no cost.
TED_ENDPOINT=https://api.ted.europa.eu/v3/notices/search
TED_LOOKBACK_DAYS=2
TED_MAX_NOTICES=1500
TED_PAGE_SIZE=100
TED_REQUEST_DELAY_MS=400
# CPV families to ingest (2-digit prefixes). 72=IT services, 48=software, 30=hardware.
TED_CPV_FAMILIES=72,48,30,79,71,32,73,80
# Optional ISO3 country restriction, e.g. DEU,AUT,CHE. Empty = all of TED.
TED_COUNTRIES=
# true = read data/fixtures instead of the network (local dev only)
TED_OFFLINE=false

# ---- Email -------------------------------------------------------------
# outbox = write .eml files to data/outbox (safe). smtp = actually send.
MAIL_TRANSPORT=smtp
# Any SMTP provider. Free tiers that work well:
#   Resend       smtp://resend:re_xxx@smtp.resend.com:587
#   Brevo        smtp://user@smtp-brevo.com:key@smtp-relay.brevo.com:587
#   Mailgun      smtp://postmaster@mg.domain:key@smtp.eu.mailgun.org:587
SMTP_URL=
# Hard cap per job run so a bug can never burn your whole sending quota.
MAIL_MAX_PER_RUN=200

# ---- Stripe ------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRICE_LABEL=€29 / month
TRIAL_DAYS=14

# Tip: `npm run cli -- setup-stripe` creates the product, price, webhook and portal
# and writes STRIPE_PRICE_ID / STRIPE_WEBHOOK_SECRET back into this file for you.

# ---- Optional LLM summaries (leave empty for zero cost) ----------------
# Without a key the service writes deterministic summaries instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Daily spend guard: max notices sent to the model per day.
LLM_MAX_ENRICH_PER_DAY=120

# ---- Scheduler (all times UTC) ----------------------------------------
SCHEDULER_ENABLED=true
INGEST_HOUR_UTC=4
DIGEST_HOUR_UTC=5
# 1 = Monday
WEEKLY_DIGEST_DAY=1
