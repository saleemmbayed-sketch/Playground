{
  "name": "tenderping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous EU/DACH IT tender alert service: ingest -> match -> email -> Stripe.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemailer": "^7.0.9",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/nodemailer": "^7.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
