{
  "name": "tenderping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous EU/DACH IT tender alert service: ingest -> match -> email -> Stripe.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "doctor": "tsx src/cli.ts doctor",
    "preflight": "node scripts/launch-preflight.mjs",
    "cli": "tsx src/cli.ts",
    "demo": "node scripts/demo.mjs",
    "fixtures": "node scripts/make-fixtures.mjs 36",
    "uat": "node scripts/uat.mjs",
    "uat:lifecycle": "tsx scripts/uat-lifecycle.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "nodemailer": "^9.1.1",
    "stripe": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.2",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
